LOG_FILE_LEVEL=INFO
LOG_FILE_ROTATION_MB=10
LOG_FILE_RETENTION_DAYS=10

# Database settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=password
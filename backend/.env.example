PROJECT_NAME=Expense Tracker
APP_VERSION=0.1.0
API_V1_STR=/api/v1
DEBUG=False

BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3000"]

NUMERIC_PRECISION=23
NUMERIC_SCALE=8

AUTH_SECRET_KEY=your_secret_key_here
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Log settings
LOG_DIR_PATH=/var/log/expense
LOG_STREAM_LEVEL=INFO
LOG_FILE_LEVEL=INFO
LOG_FILE_ROTATION_MB=10
LOG_FILE_RETENTION_DAYS=10

# Database settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=password

# Cache settings
HOST=localhost
PORT=6379
DB=0
USERNAME=user
PASSWORD=password
EXPIRE_SECONDS=3600